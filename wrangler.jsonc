{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agmcp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/llms.txt"]
  }
}
