{
  "name": "agmcp",
  "version": "0.1.0",
  "description": "USDA Agriculture Plant Hardiness Zone MCP server",
  "license": "MIT",
  "author": "weeb3dev",
  "type": "module",
  "bin": {
    "agmcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs=>fs.chmodSync('build/index.js',0o755))\"",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"build/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
